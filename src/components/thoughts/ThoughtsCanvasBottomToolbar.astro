---
interface Props {
  isDev?: boolean
}

const { isDev = false } = Astro.props
---

<div
  id="thoughts-canvas-bottom-toolbar"
  data-editable={isDev ? 'true' : 'false'}
  class:list={[
    'motion-reduce:hidden pointer-events-none fixed inset-x-0 z-40 hidden justify-center px-4 md:motion-safe:flex',
    isDev
      ? 'bottom-[max(4.75rem,calc(env(safe-area-inset-bottom)+4rem))]'
      : 'bottom-[max(1.75rem,calc(env(safe-area-inset-bottom)+0.75rem))]',
  ]}
  aria-label="Thoughts canvas controls"
>
  <div
    class="pointer-events-auto flex max-w-[min(42rem,calc(100vw-2rem))] items-center gap-2 rounded-sm border border-gray-200/90 bg-white/90 px-2 py-1.5 font-mono text-xs text-gray-800 shadow-sm backdrop-blur-sm supports-[backdrop-filter]:bg-white/80"
  >
    <div
      class="flex items-center rounded-sm border border-gray-200/80 bg-gray-50/80 p-1"
      role="group"
      aria-label="View mode"
    >
      <button
        type="button"
        id="thoughts-mode-canvas"
        class="cursor-pointer rounded-sm px-2.5 py-1 text-[11px] text-gray-700 transition-colors hover:bg-white/90 sm:text-xs"
        aria-pressed="false"
      >
        Canvas
      </button>
      <button
        type="button"
        id="thoughts-mode-card"
        class="cursor-pointer rounded-sm px-2.5 py-1 text-[11px] text-gray-700 transition-colors hover:bg-white/90 sm:text-xs"
        aria-pressed="true"
      >
        Card
      </button>
    </div>

    <div class="mx-0.5 hidden h-5 w-px bg-gray-200/90 sm:block" aria-hidden="true"></div>

    {
      isDev && (
        <>
          <div
            class="flex items-center gap-0.5 rounded-sm border border-gray-200/80 bg-white/80 px-1 py-0.5"
            aria-label="Canvas edit"
          >
            <div
              id="thoughts-canvas-edit-slot"
              class="relative h-7 min-w-[4.25rem] shrink-0"
              aria-live="polite"
            >
              <button
                type="button"
                id="thoughts-canvas-edit"
                class="absolute inset-0 cursor-pointer rounded-sm px-2 py-1 text-[11px] text-gray-700 transition-colors hover:bg-gray-100 sm:text-xs"
                aria-pressed="false"
              >
                Edit
              </button>
              <button
                type="button"
                id="thoughts-canvas-save"
                class="absolute inset-0 hidden cursor-pointer rounded-sm px-2 py-1 text-[11px] text-gray-700 transition-colors hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-35 sm:text-xs"
                disabled
              >
                Save
              </button>
              <span
                id="thoughts-canvas-edit-status"
                class="absolute inset-0 hidden select-none items-center justify-center px-2 text-[11px] text-gray-500 sm:text-xs"
              ></span>
            </div>
          </div>

          <div class="mx-0.5 hidden h-5 w-px bg-gray-200/90 sm:block" aria-hidden="true"></div>
        </>
      )
    }

    <div
      id="thoughts-canvas-zoom-cluster"
      class="flex items-center gap-0.5 rounded-sm border border-gray-200/80 bg-white/80 px-1 py-0.5 tabular-nums"
      aria-label="Canvas zoom"
    >
      <button
        type="button"
        id="thoughts-canvas-zoom-out"
        class="flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-sm text-base leading-none text-gray-700 transition-colors hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-35"
        aria-label="Zoom out"
      >
        −
      </button>
      <button
        type="button"
        id="thoughts-canvas-zoom-level-reset"
        class="min-w-[3.25rem] cursor-pointer select-none px-1 text-center text-[11px] text-gray-700 transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-35"
        aria-label="Reset zoom to 100%"
        disabled
      >
        100%
      </button>
      <button
        type="button"
        id="thoughts-canvas-zoom-in"
        class="flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-sm text-base leading-none text-gray-700 transition-colors hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-35"
        aria-label="Zoom in"
      >
        +
      </button>
      <div class="mx-0.5 h-4 w-px bg-gray-200/90" aria-hidden="true"></div>
    </div>
  </div>
</div>

<script>
import type { ThoughtsCanvasChromeOptions } from './thoughts-canvas-controller'
import { initThoughtsCanvas } from './thoughts-canvas-controller'

function qs<T extends HTMLElement>(sel: string) {
  return document.querySelector<T>(sel)
}

const root = qs<HTMLElement>('#thoughts-root')
const toolbar = qs<HTMLElement>('#thoughts-canvas-bottom-toolbar')
const cardBtn = qs<HTMLButtonElement>('#thoughts-mode-card')
const canvasBtn = qs<HTMLButtonElement>('#thoughts-mode-canvas')
const viewport = qs<HTMLElement>('#thoughts-canvas-viewport')
const world = qs<HTMLElement>('#thoughts-canvas-world')
const zoomCluster = qs<HTMLElement>('#thoughts-canvas-zoom-cluster')
const zoomOutEl = qs<HTMLButtonElement>('#thoughts-canvas-zoom-out')
const zoomInEl = qs<HTMLButtonElement>('#thoughts-canvas-zoom-in')
const zoomLevelEl = qs<HTMLButtonElement>('#thoughts-canvas-zoom-level-reset')
const resetBtn = zoomLevelEl

function chromeOpts(): ThoughtsCanvasChromeOptions {
  return {
    zoomOutBtn: qs<HTMLButtonElement>('#thoughts-canvas-zoom-out'),
    zoomInBtn: qs<HTMLButtonElement>('#thoughts-canvas-zoom-in'),
    zoomLevelEl,
    resetBtn,
    editBtn: qs<HTMLButtonElement>('#thoughts-canvas-edit'),
    saveBtn: qs<HTMLButtonElement>('#thoughts-canvas-save'),
    editStatusEl: qs<HTMLElement>('#thoughts-canvas-edit-status'),
    enableEditing: toolbar?.dataset.editable === 'true',
    initialScale: window.innerWidth < 1024 ? 0.75 : 1,
  }
}

if (root && toolbar && cardBtn && canvasBtn && viewport && world && zoomCluster && zoomOutEl && zoomInEl && zoomLevelEl) {
  let activeCanvas: ReturnType<typeof initThoughtsCanvas> | null = null

  const mqCanvasAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)')
  const mqDesktop = window.matchMedia('(min-width: 768px)')

  function preferredMode(): 'canvas' | 'card' {
    return mqCanvasAllowed.matches && mqDesktop.matches ? 'canvas' : 'card'
  }

  let currentMode: 'canvas' | 'card' = preferredMode()

  function setModeUi(mode: 'card' | 'canvas') {
    const onCanvas = mode === 'canvas'
    cardBtn!.setAttribute('aria-pressed', onCanvas ? 'false' : 'true')
    canvasBtn!.setAttribute('aria-pressed', onCanvas ? 'true' : 'false')
    cardBtn!.classList.toggle('bg-white', !onCanvas)
    cardBtn!.classList.toggle('shadow-sm', !onCanvas)
    canvasBtn!.classList.toggle('bg-white', onCanvas)
    canvasBtn!.classList.toggle('shadow-sm', onCanvas)

    const zoomLocked = !onCanvas
    zoomCluster!.classList.toggle('opacity-45', zoomLocked)
    if (zoomLocked) {
      zoomLevelEl!.textContent = '100%'
      zoomOutEl!.disabled = true
      zoomInEl!.disabled = true
      resetBtn!.disabled = true
    }
    else {
      zoomOutEl!.disabled = false
      zoomInEl!.disabled = false
      resetBtn!.disabled = false
    }
  }

  function setViewMode(mode: 'card' | 'canvas', force = false) {
    if (!force && mode === currentMode)
      return
    currentMode = mode

    if (mode === 'canvas') {
      root!.dataset.viewMode = 'canvas'
      if (!activeCanvas)
        activeCanvas = initThoughtsCanvas(viewport!, world!, chromeOpts())
      setModeUi('canvas')
    }
    else {
      root!.dataset.viewMode = 'card'
      activeCanvas?.destroy()
      activeCanvas = null
      setModeUi('card')
    }
  }

  cardBtn!.addEventListener('click', () => setViewMode('card'))
  canvasBtn!.addEventListener('click', () => setViewMode('canvas'))

  function onViewportPreferenceChange() {
    setViewMode(preferredMode())
  }

  mqCanvasAllowed.addEventListener('change', onViewportPreferenceChange)
  mqDesktop.addEventListener('change', onViewportPreferenceChange)

  setViewMode(currentMode, true)
}
</script>
