---
import Close from './icons/Close.astro'
import Copy from './icons/Copy.astro'
import Download from './icons/Download.astro'
import Share from './icons/Share.astro'

interface Stat {
  label: string
  value: string
}

interface Props {
  activityId: number
  activityName: string
  sportType: string
  sportIcon: string
  date: string
  stats: Stat[]
  points: number[][]
  pageUrl: string
}

const { activityId, activityName, sportType, sportIcon, date, stats, points, pageUrl } = Astro.props

const dialogId = `share-dialog-${activityId}`
const triggerId = `share-trigger-${activityId}`
const templateId = `share-template-${activityId}`
const posterWrapperId = `poster-wrapper-${activityId}`
const posterMapId = `poster-map-${activityId}`
const qrCodeId = `qr-code-${activityId}`
const downloadBtnId = `download-btn-${activityId}`
const closeBtnId = `close-btn-${activityId}`

// Only pass core stats to poster to keep it clean
const POSTER_STATS_COUNT = 6
const coreStats = stats.slice(0, POSTER_STATS_COUNT)
---

<!-- Trigger Button -->
<button
  id={triggerId}
  data-template-id={templateId}
  data-dialog-id={dialogId}
  class="text-gray-400 hover:text-gray-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2 rounded-sm cursor-pointer"
  aria-label="Share workout"
  title="Share workout"
>
  <Share />
</button>

<!-- Dialog Template (lazy: cloned into DOM on first open) -->
<template id={templateId}>
  <div
    id={dialogId}
    role="dialog"
    aria-modal="true"
    aria-labelledby={`share-title-${activityId}`}
    class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
  >
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm share-backdrop" data-dialog-close={dialogId}></div>

    <!-- Dialog Panel -->
    <div class="relative z-10 bg-white w-full max-w-md max-h-[92vh] overflow-y-auto shadow-2xl flex flex-col">
      <!-- Dialog Header -->
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 id={`share-title-${activityId}`} class="text-sm font-semibold font-mono text-gray-900">Share Workout</h2>
        <button
          id={closeBtnId}
          data-dialog-close={dialogId}
          class="text-gray-400 hover:text-gray-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2 rounded-sm cursor-pointer"
          aria-label="Close share dialog"
        >
          <Close />
        </button>
      </div>

      <!-- Poster Preview Area -->
      <div class="p-5">
        <!-- The actual poster element that gets captured -->
        <div
          id={posterWrapperId}
          class="poster-wrapper relative bg-white overflow-hidden"
          style="width: 100%; aspect-ratio: 3/4; border: 1px solid #e5e7eb;"
          data-points={JSON.stringify(points)}
          data-page-url={pageUrl}
          data-map-id={posterMapId}
          data-qr-id={qrCodeId}
        >
          <!-- Top gradient accent -->
          <div
            class="absolute top-0 left-0 right-0 h-1 z-10"
            style="background: linear-gradient(90deg, #10b981, #3b82f6, #8b5cf6)"
          >
          </div>

          <!-- Map: basemap faded via CSS on .leaflet-tile-pane only; route stays opaque -->
          <div id={posterMapId} class="poster-map-container absolute inset-0" style="z-index: 0;"></div>

          <!-- Content overlay -->
          <div class="absolute inset-0 flex flex-col justify-between px-3 py-2 md:px-5 z-10">
            <!-- Top: sport icon + title -->
            <div>
              <div class="flex items-baseline gap-2 mb-2">
                <span class="text-2xl">{sportIcon}</span>
                <span class="text-base font-bold font-mono text-emerald-600 uppercase tracking-widest">
                  {sportType}
                </span>
              </div>
              <h3 class="text-gray-900 font-bold font-mono text-lg leading-tight line-clamp-2">
                {activityName}
              </h3>
              <p class="text-gray-900 font-mono text-[10px] mt-1 drop-shadow-[0_0_6px_rgba(255,255,255,0.95)]">
                {date}
              </p>
            </div>

            <!-- Core Stats Grid -->
            <div class="grid grid-cols-3 gap-2 mt-auto mb-3">
              {
                coreStats.map(stat => (
                  <div class="bg-gray-50 border border-gray-200 p-2 min-w-0">
                    <div class="text-[9px] text-gray-400 font-mono mb-0.5 truncate">{stat.label}</div>
                    <div class="text-gray-900 font-mono font-semibold text-xs leading-tight whitespace-nowrap">
                      {stat.value}
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- Bottom: QR code + branding -->
            <div class="flex items-end justify-between">
              <div class="px-2">
                <p class="text-sm font-mono text-gray-900 drop-shadow-[0_0_6px_rgba(255,255,255,0.95)] mb-1">yuler.dev</p>
                <p class="text-xs font-mono text-gray-900 drop-shadow-[0_0_6px_rgba(255,255,255,0.95)]">
                  Scan to view activity
                </p>
              </div>
              <div class="shrink-0 overflow-hidden bg-white p-1">
                <canvas id={qrCodeId} width="60" height="60" class="block" style="image-rendering: pixelated;">
                </canvas>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="px-5 pb-5 flex gap-3">
        <button
          id={downloadBtnId}
          data-wrapper-id={posterWrapperId}
          data-activity-name={activityName}
          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-gray-900 text-white text-sm font-mono hover:bg-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
          aria-label="Download poster"
        >
          <Download class="download-icon" />
          <span class="btn-label">Download</span>
        </button>

        <button
          data-copy-id={posterWrapperId}
          data-activity-name={activityName}
          class="copy-poster-btn inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-mono text-gray-500 hover:text-gray-900 border border-gray-200 hover:border-gray-400 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
          aria-label="Copy poster to clipboard"
        >
          <Copy />
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>
  </div>
</template>

<script>
import L from 'leaflet'
import QRCode from 'qrcode'
import {
  addLightBasemapTiles,
  LEAFLET_MAP_OPTIONS_FRACTIONAL_ZOOM,
  nudgeZoomOutAfterFit,
  resolveBasemapProvider,
  toMapCoords,
} from '../lib/leafletTiles'

/** Poster capture only runs after the share dialog opens; html-to-image stays dynamic. */
const htmlToImagePromise = import('html-to-image')

const dialogFocusStack: HTMLElement[] = []
const leafletMaps = new Map<string, L.Map>()
/** LatLngs for poster route redraw during capture (keyed by map element id). */
const posterRouteLatLngs = new Map<string, L.LatLng[]>()
/** Resolves when QR + map tiles are ready for a reliable capture. */
const posterReady = new Map<string, Promise<void>>()

/** Slow mobile networks often need more than a few seconds for basemap tiles. */
const POSTER_TILE_WAIT_MS = 15000
/** Require tiles to stay fully loaded this long before treating as stable. */
const POSTER_TILE_STABLE_MS = 300
const POSTER_CAPTURE_SETTLE_MS = 150

// ── Dialog open / close / destroy ─────────────────────────────────────────

function openDialog(dialogId: string, templateId?: string) {
  // Already open — ignore
  if (document.getElementById(dialogId))
    return

  // Clone from <template>
  const template = templateId
    ? document.getElementById(templateId) as HTMLTemplateElement | null
    : null
  if (!template)
    return
  document.body.appendChild(template.content.cloneNode(true))

  const dialog = document.getElementById(dialogId)
  if (!dialog)
    return

  const ae = document.activeElement
  if (ae instanceof HTMLElement)
    dialogFocusStack.push(ae)

  document.body.classList.add('overflow-hidden')

  const wrapper = dialog.querySelector('.poster-wrapper') as HTMLElement | null
  if (wrapper)
    posterReady.set(wrapper.id, initPoster(wrapper))

  requestAnimationFrame(() => {
    dialog.querySelector<HTMLButtonElement>(
      'button[aria-label="Close share dialog"]',
    )?.focus()
  })
}

function destroyDialog(dialogId: string) {
  const dialog = document.getElementById(dialogId)
  if (!dialog)
    return

  // Tear down Leaflet map to free tiles / event listeners
  const wrapper = dialog.querySelector('.poster-wrapper') as HTMLElement | null
  const mapId = wrapper?.dataset.mapId
  if (wrapper)
    posterReady.delete(wrapper.id)
  if (mapId) {
    leafletMaps.get(mapId)?.remove()
    leafletMaps.delete(mapId)
    posterRouteLatLngs.delete(mapId)
  }

  dialog.remove()
  document.body.classList.remove('overflow-hidden')

  const prev = dialogFocusStack.pop()
  prev?.focus()
}

// Wire triggers & close buttons — single delegated listener
document.addEventListener('click', (e) => {
  const target = e.target as HTMLElement

  const openBtn = target.closest<HTMLButtonElement>('[data-dialog-id]')
  if (openBtn) {
    openDialog(openBtn.dataset.dialogId!, openBtn.dataset.templateId)
    return
  }

  const closeEl = target.closest<HTMLElement>('[data-dialog-close]')
  if (closeEl) {
    destroyDialog(closeEl.dataset.dialogClose!)
  }
})

// Close on Escape
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    document.querySelectorAll<HTMLElement>('[role="dialog"]').forEach((dialog) => {
      destroyDialog(dialog.id)
    })
  }
})

// ── Debounced window resize — destroy open dialogs so next open re-renders at new size
let resizeTimer: ReturnType<typeof setTimeout>
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer)
  resizeTimer = setTimeout(() => {
    document.querySelectorAll<HTMLElement>('[role="dialog"]').forEach((dialog) => {
      destroyDialog(dialog.id)
    })
  }, 300)
})

// ── Poster initializer ─────────────────────────────────────────────────────

function getLoadedTileImages(mapEl: HTMLElement): HTMLImageElement[] {
  return [...mapEl.querySelectorAll<HTMLImageElement>('img.leaflet-tile.leaflet-tile-loaded')]
    .filter(img => img.complete && img.naturalWidth > 0)
}

/** True when the active basemap has decoded tile images. */
function areBasemapTilesReady(mapEl: HTMLElement): boolean {
  return getLoadedTileImages(mapEl).length > 0
}

/**
 * Poll until basemap tiles are decoded and stay that way briefly.
 * Returns false on timeout (does not pretend success).
 */
async function waitForMapTilesReady(mapEl: HTMLElement, timeoutMs: number): Promise<boolean> {
  const start = Date.now()
  let stableSince: number | null = null

  while (Date.now() - start < timeoutMs) {
    if (areBasemapTilesReady(mapEl)) {
      if (stableSince === null)
        stableSince = Date.now()
      else if (Date.now() - stableSince >= POSTER_TILE_STABLE_MS)
        return true
    }
    else {
      stableSince = null
    }
    await new Promise<void>(resolve => window.setTimeout(resolve, 50))
  }
  return areBasemapTilesReady(mapEl)
}

function settleFrames(ms = POSTER_CAPTURE_SETTLE_MS): Promise<void> {
  return new Promise((resolve) => {
    let settled = false
    const finish = () => {
      if (settled)
        return
      settled = true
      clearTimeout(fallback)
      resolve()
    }
    // Mobile WebKit/background tabs can pause rAF indefinitely.
    const fallback = window.setTimeout(finish, ms + 250)
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        window.setTimeout(finish, ms)
      })
    })
  })
}

function isQrCanvasDrawn(canvas: HTMLCanvasElement): boolean {
  const ctx = canvas.getContext('2d', { willReadFrequently: true })
  if (!ctx)
    return false
  try {
    const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height)
    for (let i = 0; i < data.length; i += 4) {
      if (data[i + 3] > 0 && (data[i] < 240 || data[i + 1] < 240 || data[i + 2] < 240))
        return true
    }
  }
  catch {
    return false
  }
  return false
}

function drawPosterRoute(
  ctx: CanvasRenderingContext2D,
  map: L.Map,
  latlngs: L.LatLng[],
): void {
  if (latlngs.length < 2)
    return

  const pts = latlngs.map(ll => map.latLngToContainerPoint(ll))

  ctx.save()
  ctx.lineCap = 'round'
  ctx.lineJoin = 'round'

  ctx.beginPath()
  ctx.moveTo(pts[0].x, pts[0].y)
  for (let i = 1; i < pts.length; i++)
    ctx.lineTo(pts[i].x, pts[i].y)
  ctx.strokeStyle = '#34d399'
  ctx.globalAlpha = 0.35
  ctx.lineWidth = 8
  ctx.stroke()

  ctx.beginPath()
  ctx.moveTo(pts[0].x, pts[0].y)
  for (let i = 1; i < pts.length; i++)
    ctx.lineTo(pts[i].x, pts[i].y)
  ctx.strokeStyle = '#059669'
  ctx.globalAlpha = 1
  ctx.lineWidth = 4
  ctx.stroke()

  const drawMarker = (pt: L.Point, color: string) => {
    ctx.beginPath()
    ctx.arc(pt.x, pt.y, 4, 0, Math.PI * 2)
    ctx.fillStyle = color
    ctx.fill()
    ctx.lineWidth = 2
    ctx.strokeStyle = '#ffffff'
    ctx.stroke()
  }
  drawMarker(pts[0], '#10b981')
  drawMarker(pts[pts.length - 1], '#ef4444')
  ctx.restore()
}

/**
 * Flatten the live Leaflet map into one PNG data URL.
 * Draws already-decoded CORS tile images and redraws the route from LatLngs.
 * No second network request is made during Copy/Download.
 */
async function rasterizePosterMap(map: L.Map, latlngs: L.LatLng[]): Promise<string> {
  const mapEl = map.getContainer()
  const size = map.getSize()
  const width = size.x
  const height = size.y
  if (width < 2 || height < 2)
    throw new Error('Poster map has no size')

  const dpr = Math.min(window.devicePixelRatio || 1, 2)
  const canvas = document.createElement('canvas')
  canvas.width = Math.max(1, Math.round(width * dpr))
  canvas.height = Math.max(1, Math.round(height * dpr))
  const ctx = canvas.getContext('2d')
  if (!ctx)
    throw new Error('Could not create map capture canvas')

  ctx.scale(dpr, dpr)
  ctx.fillStyle = '#e5e7eb'
  ctx.fillRect(0, 0, width, height)

  const tileImgs = getLoadedTileImages(mapEl)
  ctx.save()
  // Match .poster-map-container .leaflet-tile-pane { opacity: 0.5 }
  ctx.globalAlpha = 0.5
  let drawnTiles = 0
  for (const domImg of tileImgs) {
    // Use layout coords relative to map container; bounding rect can drift on mobile WebKit.
    const x = domImg.offsetLeft
    const y = domImg.offsetTop
    const w = domImg.width
    const h = domImg.height
    if (w <= 1 || h <= 1)
      continue
    // Skip tiles fully outside the visible map box.
    if (x + w < 0 || y + h < 0 || x > width || y > height)
      continue
    try {
      ctx.drawImage(domImg, x, y, w, h)
      drawnTiles++
    }
    catch (err) {
      console.warn('Poster tile draw failed:', err)
    }
  }
  ctx.restore()

  if (drawnTiles === 0)
    throw new Error('Failed to rasterize basemap tiles')

  drawPosterRoute(ctx, map, latlngs)

  return canvas.toDataURL('image/png')
}

interface FrozenPoster {
  mapDataUrl: string
  captureNode: HTMLElement
  cleanup: () => void
}

/**
 * Build an offscreen content-only clone behind the dialog. The visible preview
 * is never mutated, so capture cannot flash while map and QR layers are prepared.
 */
async function freezePosterForCapture(wrapper: HTMLElement): Promise<FrozenPoster> {
  const qrId = wrapper.dataset.qrId
  const qrCanvas = qrId ? document.getElementById(qrId) as HTMLCanvasElement | null : null
  if (!qrCanvas || !isQrCanvasDrawn(qrCanvas))
    throw new Error('QR code is not ready')
  const qrDataUrl = qrCanvas.toDataURL('image/png')
  if (qrDataUrl === 'data:,')
    throw new Error('QR code canvas is empty')

  const mapId = wrapper.dataset.mapId
  const map = mapId ? leafletMaps.get(mapId) : undefined
  const mapEl = mapId ? document.getElementById(mapId) : null
  const latlngs = mapId ? posterRouteLatLngs.get(mapId) : undefined
  if (!map || !mapEl || !latlngs)
    throw new Error('Poster map is not initialized')
  if (!areBasemapTilesReady(mapEl))
    throw new Error('Basemap tiles are still loading')

  const mapDataUrl = await rasterizePosterMap(map, latlngs)

  const rect = wrapper.getBoundingClientRect()
  const dialog = wrapper.closest('[role="dialog"]')
  const host = document.createElement('div')
  host.setAttribute('aria-hidden', 'true')
  // Same screen box as the poster, stacked behind the dialog — invisible, no flash.
  host.style.cssText = `position:fixed;left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;height:${rect.height}px;z-index:9998;pointer-events:none;visibility:hidden;overflow:hidden;`

  const captureNode = wrapper.cloneNode(true) as HTMLElement
  captureNode.removeAttribute('id')
  captureNode.querySelector('.poster-map-container')?.remove()
  captureNode.style.width = `${rect.width}px`
  captureNode.style.height = `${rect.height}px`
  captureNode.style.aspectRatio = 'auto'
  captureNode.style.backgroundColor = 'transparent'

  const clonedQr = captureNode.querySelector<HTMLCanvasElement>('canvas')
  if (!clonedQr)
    throw new Error('Cloned QR code is missing')
  const qrImg = document.createElement('img')
  qrImg.src = qrDataUrl
  qrImg.width = qrCanvas.width
  qrImg.height = qrCanvas.height
  qrImg.alt = ''
  qrImg.className = clonedQr.className
  qrImg.style.cssText = clonedQr.style.cssText || 'display:block;image-rendering:pixelated;'
  clonedQr.replaceWith(qrImg)

  host.appendChild(captureNode)
  if (dialog?.parentNode)
    dialog.parentNode.insertBefore(host, dialog)
  else
    document.body.appendChild(host)
  await qrImg.decode()

  await settleFrames()
  return {
    mapDataUrl,
    captureNode,
    cleanup: () => host.remove(),
  }
}

async function imageFromSource(src: string): Promise<HTMLImageElement> {
  const img = new Image()
  img.src = src
  await img.decode()
  return img
}

/**
 * Compose the map and the html-to-image content layer directly on a canvas.
 * This bypasses WebKit's unreliable rendering of embedded images in foreignObject.
 */
async function composePosterBlob(mapDataUrl: string, contentBlob: Blob): Promise<Blob> {
  const contentUrl = URL.createObjectURL(contentBlob)
  try {
    const [mapImg, contentImg] = await Promise.all([
      imageFromSource(mapDataUrl),
      imageFromSource(contentUrl),
    ])
    const canvas = document.createElement('canvas')
    canvas.width = contentImg.naturalWidth
    canvas.height = contentImg.naturalHeight
    const ctx = canvas.getContext('2d')
    if (!ctx)
      throw new Error('Could not create poster composition canvas')

    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, canvas.width, canvas.height)
    ctx.drawImage(mapImg, 0, 0, canvas.width, canvas.height)
    ctx.drawImage(contentImg, 0, 0)

    return await new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob)
          resolve(blob)
        else
          reject(new Error('Failed to compose poster image'))
      }, 'image/png')
    })
  }
  finally {
    URL.revokeObjectURL(contentUrl)
  }
}

async function initPoster(wrapper: HTMLElement): Promise<void> {
  await resolveBasemapProvider()

  const mapId = wrapper.dataset.mapId!
  const qrId = wrapper.dataset.qrId!
  const pageUrl = wrapper.dataset.pageUrl!
  const pointsRaw = wrapper.dataset.points!

  // 1. QR Code — opaque light modules so capture never shows map bleed-through
  const qrCanvas = document.getElementById(qrId) as HTMLCanvasElement | null
  const qrReady = qrCanvas
    ? QRCode.toCanvas(qrCanvas, pageUrl, {
        width: 60,
        margin: 1,
        color: { light: '#ffffffff', dark: '#111827ff' },
        errorCorrectionLevel: 'M',
      }).catch((err) => {
        console.error('Failed to generate QR code:', err)
        const ctx = qrCanvas.getContext('2d')
        if (ctx) {
          ctx.fillStyle = '#ef4444'
          ctx.font = '8px monospace'
          ctx.fillText('QR error', 2, 32)
        }
      })
    : Promise.resolve()

  // 2. Route map (no controls, static display; canvas paths capture more reliably)
  const mapEl = document.getElementById(mapId)
  if (!mapEl) {
    await qrReady
    return
  }

  let points: number[][] = []
  try {
    points = JSON.parse(pointsRaw)
  }
  catch (e) {
    console.error('Failed to parse points data for poster map:', e)
    await qrReady
    return
  }
  if (points.length === 0) {
    await qrReady
    return
  }

  const map = L.map(mapId, {
    zoomControl: false,
    attributionControl: false,
    dragging: false,
    touchZoom: false,
    scrollWheelZoom: false,
    doubleClickZoom: false,
    keyboard: false,
    preferCanvas: true,
    fadeAnimation: false,
    ...LEAFLET_MAP_OPTIONS_FRACTIONAL_ZOOM,
    zoomAnimation: false,
    markerZoomAnimation: false,
  })

  // Layout after clone into dialog — without this, tiles/vectors can be blank on first paint.
  map.invalidateSize({ animate: false })

  addLightBasemapTiles(map, { labels: false, crossOrigin: true })

  const latlngs = points.map((p: number[]) => {
    const [lat, lng] = toMapCoords(p[0], p[1])
    return L.latLng(lat, lng)
  })

  // Draw a soft halo under the route so it stands out on light basemaps.
  L.polyline(latlngs, {
    color: '#34d399',
    weight: 8,
    opacity: 0.35,
    lineCap: 'round',
    lineJoin: 'round',
    smoothFactor: 1,
  }).addTo(map)

  const routeLine = L.polyline(latlngs, {
    color: '#059669',
    weight: 4,
    opacity: 1,
    lineCap: 'round',
    lineJoin: 'round',
    smoothFactor: 1,
  }).addTo(map)

  const startHtml = '<div class="poster-map-marker start-marker"></div>'
  L.marker(latlngs[0], {
    icon: L.divIcon({ html: startHtml, className: '', iconSize: [8, 8], iconAnchor: [4, 4] }),
  }).addTo(map)

  const endHtml = '<div class="poster-map-marker end-marker"></div>'
  const endLatLng = latlngs.at(-1)
  if (endLatLng) {
    L.marker(endLatLng, {
      icon: L.divIcon({ html: endHtml, className: '', iconSize: [8, 8], iconAnchor: [4, 4] }),
    }).addTo(map)
  }

  const posterMapStatsOverlayPaddingPx = 220
  map.fitBounds(routeLine.getBounds(), {
    paddingTopLeft: [28, 28],
    paddingBottomRight: [28, posterMapStatsOverlayPaddingPx],
    animate: false,
  })
  nudgeZoomOutAfterFit(map, 0.4)
  map.invalidateSize({ animate: false })

  leafletMaps.set(mapId, map)
  posterRouteLatLngs.set(mapId, latlngs)

  await qrReady
  const tilesReady = await waitForMapTilesReady(mapEl, POSTER_TILE_WAIT_MS)
  if (!tilesReady)
    console.warn('Poster basemap tiles did not finish loading before timeout')
  await settleFrames()
}

// ── Shared: capture poster as Blob ────────────────────────────────────────

async function waitUntilPosterReady(wrapperId: string): Promise<void> {
  const ready = posterReady.get(wrapperId)
  if (ready)
    await ready
}

async function capturePosterBlob(wrapperId: string): Promise<Blob> {
  const wrapper = document.getElementById(wrapperId)
  if (!wrapper)
    throw new Error('Poster wrapper not found')

  await waitUntilPosterReady(wrapperId)

  const mapId = wrapper.dataset.mapId
  const mapEl = mapId ? document.getElementById(mapId) : null
  // Do NOT invalidateSize here — it restarts tile loads on mobile and races the capture.
  if (mapEl) {
    const tilesReady = await waitForMapTilesReady(mapEl, POSTER_TILE_WAIT_MS)
    if (!tilesReady)
      throw new Error('Basemap tiles are still loading')
  }

  const qrId = wrapper.dataset.qrId
  const qrCanvas = qrId ? document.getElementById(qrId) as HTMLCanvasElement | null : null
  if (qrCanvas && !isQrCanvasDrawn(qrCanvas))
    throw new Error('QR code is not ready')

  const frozen = await freezePosterForCapture(wrapper)
  try {
    const { toBlob } = await htmlToImagePromise
    // Lower DPR on phones to avoid silent canvas failures from memory pressure.
    const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches
    const pixelRatio = isCoarsePointer
      ? Math.min(2, window.devicePixelRatio || 1)
      : 2
    const contentBlob = await toBlob(frozen.captureNode, {
      cacheBust: false,
      pixelRatio,
      skipFonts: false,
    })
    if (!contentBlob)
      throw new Error('Failed to generate image blob')
    return await composePosterBlob(frozen.mapDataUrl, contentBlob)
  }
  finally {
    frozen.cleanup()
  }
}

/**
 * Safari drops user-activation if we `await` blob generation before `clipboard.write`.
 * Pass a Promise into ClipboardItem so write() is invoked synchronously in the click path.
 * Falls back to Web Share / download when image clipboard write is blocked.
 */
async function copyPosterBlob(wrapperId: string, activityName: string): Promise<'copied' | 'shared' | 'downloaded'> {
  const filename = `workout-${activityName.replace(/\s+/g, '-').toLowerCase()}.png`
  const blobPromise = capturePosterBlob(wrapperId)

  try {
    await navigator.clipboard.write([
      new ClipboardItem({ 'image/png': blobPromise }),
    ])
    return 'copied'
  }
  catch (clipboardErr) {
    console.warn('Clipboard image write failed, trying share/download fallback:', clipboardErr)
  }

  const blob = await blobPromise
  const file = new File([blob], filename, { type: 'image/png' })

  if (typeof navigator.canShare === 'function' && navigator.canShare({ files: [file] })) {
    try {
      await navigator.share({ files: [file], title: activityName })
      return 'shared'
    }
    catch (shareErr) {
      // User dismissed the share sheet — treat as cancel, not a hard failure.
      if (shareErr instanceof Error && shareErr.name === 'AbortError')
        throw shareErr
      console.warn('Web Share failed, falling back to download:', shareErr)
    }
  }

  triggerBlobDownload(blob, filename)
  return 'downloaded'
}

function triggerBlobDownload(blob: Blob, filename: string): void {
  const url = URL.createObjectURL(blob)
  const link = document.createElement('a')
  link.download = filename
  link.href = url
  link.rel = 'noopener'
  document.body.appendChild(link)
  link.click()
  link.remove()
  URL.revokeObjectURL(url)
}

async function downloadPosterBlob(wrapperId: string, activityName: string): Promise<void> {
  const blob = await capturePosterBlob(wrapperId)
  const filename = `workout-${activityName.replace(/\s+/g, '-').toLowerCase()}.png`
  triggerBlobDownload(blob, filename)
}

// ── Poster actions (download / copy) — single delegated listener ─────────────

document.addEventListener('click', async (e) => {
  const target = e.target as HTMLElement
  const downloadBtn = target.closest<HTMLButtonElement>('[data-wrapper-id]')
  const copyBtn = target.closest<HTMLButtonElement>('.copy-poster-btn')

  if (!downloadBtn && !copyBtn)
    return

  const btn = (downloadBtn || copyBtn)!
  if (btn.disabled)
    return

  const isCopy = !!copyBtn
  const wrapperId = isCopy ? btn.dataset.copyId! : btn.dataset.wrapperId!
  const activityName = btn.dataset.activityName || 'workout'
  const label = btn.querySelector(isCopy ? '.copy-label' : '.btn-label')

  const resetAction = () => {
    if (label)
      label.textContent = isCopy ? 'Copy' : 'Download'
  }

  // Each action owns only its own pending state.
  btn.disabled = true
  if (label)
    label.textContent = isCopy ? 'Copying…' : 'Downloading…'

  try {
    if (isCopy) {
      const result = await copyPosterBlob(wrapperId, activityName)
      if (label) {
        label.textContent = result === 'copied'
          ? 'Copied!'
          : result === 'shared'
            ? 'Shared!'
            : 'Saved!'
      }
    }
    else {
      await downloadPosterBlob(wrapperId, activityName)
      if (label)
        label.textContent = 'Downloaded!'
    }

    // Completion immediately restores clickability; the success label remains briefly.
    btn.disabled = false
    window.setTimeout(resetAction, 2000)
  }
  catch (err) {
    // Share sheet dismissed — restore quietly.
    if (err instanceof Error && err.name === 'AbortError') {
      btn.disabled = false
      resetAction()
      return
    }
    console.error(`Failed to ${isCopy ? 'copy' : 'download'} poster:`, err)
    if (label)
      label.textContent = 'Failed'
    btn.disabled = false
    window.setTimeout(resetAction, 2000)
  }
})
</script>

