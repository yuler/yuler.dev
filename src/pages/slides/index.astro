---
import CornerMarkers from '../../components/CornerMarkers.astro'
import Play from '../../components/icons/Play.astro'
import Layout from '../../layouts/Layout.astro'
import { getAllSlideDecks } from '../../lib/slides'

const decks = await getAllSlideDecks()
---

<Layout
  title="Slides — Presentations & Talks"
  description="Technical slide decks and presentations built with Slidev and Markdown."
>
  <div class="min-h-screen bg-[#f5f5f5] text-gray-900">
    <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs sm:text-sm text-gray-500 mb-6 sm:mb-8 font-mono">
        <a href="/" class="hover:text-gray-900 transition-colors">~</a>
        <span class="text-gray-300">/</span>
        <span class="text-gray-900">slides</span>
      </nav>

      <!-- Header Card -->
      <div class="relative bg-white border border-gray-200 p-6 md:p-8 mb-6">
        <CornerMarkers />
        <div class="flex items-center justify-between gap-3 mb-2">
          <h1 class="text-2xl md:text-3xl font-bold font-mono text-gray-900">Slides</h1>
          <span class="px-2 py-0.5 text-xs bg-gray-100 text-gray-600 font-mono border border-gray-200">
            {decks.length} {decks.length === 1 ? 'Deck' : 'Decks'}
          </span>
        </div>
        <p class="text-sm text-gray-500 font-mono">
          这里收录了我所有的 Slides 幻灯片与技术分享演示文稿。
        </p>
      </div>

      <!-- Slide Decks Grid -->
      <div class="space-y-4">
        {decks.map(deck => (
          <div class="relative bg-white border border-gray-200 p-6 transition-all duration-300 hover:border-gray-400">
            <CornerMarkers />
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <h2 class="text-xl font-bold text-gray-900 font-mono mb-2">
                  <a href={`/slides/${deck.slug}`} class="hover:underline transition-colors">
                    {deck.title}
                  </a>
                </h2>
                <div class="flex items-center gap-2 text-xs font-mono text-gray-500 mb-3">
                  <span>{deck.slideCount} Slides</span>
                  <span class="text-gray-300">|</span>
                  <span>Slidev Format</span>
                </div>
                <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                  {deck.description || '基于 Mac mini 私有算力与 Grok Bot 多 Agent 协作的移动端极客开发范式。'}
                </p>
                <div class="text-xs font-mono text-gray-400 flex items-center gap-2">
                  <span>Path: <code class="text-gray-600">src/content/slides/{deck.slug}/slides.md</code></span>
                </div>
              </div>

              <!-- Action Button -->
              <div class="shrink-0 flex sm:flex-col gap-2">
                <a
                  href={`/slides/${deck.slug}`}
                  class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 hover:text-gray-900 border border-gray-200 hover:border-gray-300 font-mono text-xs transition-colors"
                >
                  <Play size={12} class="fill-current" />
                  <span>播放幻灯片</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
